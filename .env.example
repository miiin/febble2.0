# Neon 콘솔 > Connection string (pooled)
DATABASE_URL=

# Auth.js — npx auth secret 로 생성
AUTH_SECRET=
# Google Cloud 콘솔 OAuth 클라이언트 (리디렉션 URI: <origin>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 카카오 개발자 콘솔 REST API 키 / Client Secret (리디렉션 URI: <origin>/api/auth/callback/kakao)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Cloudflare R2 (이미지 저장소). R2 > 버킷 > 설정 > 공개 액세스에서 r2.dev 주소나 도메인을 켠다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=febble-media
R2_PUBLIC_URL=
# Claude API (포스터 읽기)
ANTHROPIC_API_KEY=

# Spotify Web API (어드민 아티스트 검색, client credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Kopis (공연정보 크롤링) — kopis.or.kr 에서 발급
KOPIS_API_KEY=